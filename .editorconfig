# Editor defaults so Windows and POSIX contributors produce identical diffs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown,yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Generated digests contain deliberate trailing double-spaces for line breaks.
trim_trailing_whitespace = false
