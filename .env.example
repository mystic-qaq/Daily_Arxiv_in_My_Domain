# Copy this file to `.env` in the project root (the CLI loads it automatically),
# or export the same variables in your shell. Never commit a real key.
#
# Precedence: real environment variables > .env > built-in defaults.

# --- Route 1 (default): OpenAI or any OpenAI-compatible endpoint ------------
OPENAI_API_KEY=
# Set this only when you are not talking to api.openai.com,
# e.g. https://api.deepseek.com  or  http://localhost:8000/v1
OPENAI_BASE_URL=

# --- Route 2: DeepSeek (uses the OpenAI-compatible client) -----------------
# Pair it with:  ARXIV_AGENT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# --- Which model to use for triage + analysis ------------------------------
# Model ids starting with gpt/o1/o3/o4/oss, or any id when OPENAI_BASE_URL is
# set, resolve to the OpenAI-compatible provider. Ids starting with "hy" (or
# containing "codebuddy") resolve to a locally authenticated CLI gateway.
ARXIV_AGENT_MODEL=gpt-4.1-mini
# Force a backend instead of inferring it: auto|openai|codebuddy|offline
ARXIV_AGENT_PROVIDER=

# --- Optional knobs --------------------------------------------------------
# Where reports are written.
ARXIV_AGENT_OUTPUT_DIR=reports
# Where the evolving strategy, seen-paper list and caches live.
ARXIV_AGENT_STATE_DIR=.arxiv-agent

# Recommended: raises the GitHub API budget (core 60 -> 5000, search 10 -> 30 per hour).
GITHUB_TOKEN=

# Uncomment to print a traceback when `work` fails (it stays silent otherwise).
# ARXIV_AGENT_DEBUG=1
